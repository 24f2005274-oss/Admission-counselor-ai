# Copy this file to .env.local and fill in your keys

# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# STT — Deepgram Nova-3 — https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key

# TTS — Sarvam bulbul:v3 — https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key

# Voice override (optional) — sumit, arya, priya, abhilash, etc.
# SARVAM_VOICE=sumit

# Default TTS language: en | hi | bn
DEFAULT_LANGUAGE=en
